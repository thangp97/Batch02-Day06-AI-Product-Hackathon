generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Specialty {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  slots Slot[]

  @@map("specialties")
}

model Slot {
  id          Int       @id @default(autoincrement())
  specialtyId Int       @map("specialty_id")
  doctor      String
  scheduledAt DateTime  @map("scheduled_at")
  available   Boolean   @default(true)

  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@map("slots")
}

model Booking {
  id          Int      @id @default(autoincrement())
  slotId      Int      @map("slot_id")
  patientName String   @map("patient_name")
  patientPhone String  @map("patient_phone")
  createdAt   DateTime @default(now()) @map("created_at")

  slot      Slot       @relation(fields: [slotId], references: [id])
  feedbacks Feedback[]

  @@map("bookings")
}

model TriageLog {
  id           Int      @id @default(autoincrement())
  symptoms     String
  aiLevel      String   @map("ai_level")
  aiSuggested  String?  @map("ai_suggested")
  userAction   String   @map("user_action")
  userSelected String?  @map("user_selected")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("triage_logs")
}

// Lưu từng lượt hội thoại — nhóm theo sessionId
model ConversationMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")           // UUID do frontend tạo
  role      String                                 // "user" | "assistant"
  content   String
  metadata  Json?                                  // { level, specialtyCode, ... } cho lượt assistant
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("conversation_messages")
}

// Feedback sau khi dùng dịch vụ
model Feedback {
  id        Int      @id @default(autoincrement())
  sessionId String?  @map("session_id")           // liên kết với cuộc hội thoại (tuỳ chọn)
  bookingId Int?     @map("booking_id")            // liên kết với lịch đã đặt (tuỳ chọn)
  rating    Int                                    // 1–5
  comment   String?                               // nhận xét tự do
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@map("feedbacks")
}

